# Copy this file to backend/.env and fill in real values.
# Never commit backend/.env (it holds real secrets) — only this .example file is tracked.
#
# All four keys below are optional and independent. They form a fallback
# chain for scanned PDF pages with NO extractable text (pages pdfplumber can
# already read directly never touch any of this):
#   Gemini (primary) -> Groq (secondary) -> OpenRouter free vision (tertiary)
#   -> Mistral OCR (quaternary) -> Tesseract (guaranteed final fallback).
# Leave any subset blank — Tesseract alone always works with zero keys set.
# The startup log and GET /api/extract/providers/health report each one's
# status separately, so you can confirm a key is live without uploading a
# real file first.

# Get a free key from Google AI Studio: https://aistudio.google.com/apikey
# Leave blank to skip Gemini and fall through to the next provider.
GEMINI_API_KEY=your-key-here

# Gemini model id. Google periodically retires model ids (e.g.
# gemini-2.0-flash was shut down 2026-06-01) — if Gemini calls start
# failing with a "not found"/"deprecated" error, check
# https://ai.google.dev/gemini-api/docs/models for the current model id
# and update this value; no code change needed.
GEMINI_MODEL=gemini-2.5-flash

# Get a free key from https://console.groq.com/keys
# Leave blank to skip Groq and fall through to the next provider.
GROQ_API_KEY=your-key-here

# Get a free key from https://openrouter.ai/keys
# Leave blank to skip OpenRouter and fall through to the next provider.
OPENROUTER_API_KEY=your-key-here

# Get a free key from https://console.mistral.ai/api-keys
# Leave blank to skip Mistral and fall through to Tesseract.
MISTRAL_API_KEY=your-key-here
