# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# this repo's frontend/ lives in a subdirectory, not the root, so the
# anchored patterns above don't match its build output/dependencies
frontend/node_modules/
frontend/.next/
frontend/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# ---- Python Backend ----
# Virtual environment
backend/.venv/
backend/__pycache__/
backend/**/__pycache__/
**/__pycache__/
*.pyc
*.pyo

# Pytest
backend/.pytest_cache/
.pytest_cache/

# ---- IDE / Editor ----
.vscode/
.idea/

# ---- GSD / Agent ----
.gsd/
.agent/
.gemini/

# ---- Logs & temp files ----
*.log
test-errors.log
ts_errors.txt
.env
.env.*
*.env
credentials.json
*.key
.credentials
